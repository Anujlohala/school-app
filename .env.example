# Browser-safe Supabase project URL. Leave empty until the database phase.
NEXT_PUBLIC_SUPABASE_URL=

# Browser-safe Supabase publishable key. This is not the service-role secret.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only account mapping used by the future administrator login flow.
ADMIN_LOGIN_EMAIL=

# Server-only account mapping used by the future shared-member login flow.
MEMBER_LOGIN_EMAIL=

# Calendar and display timezone for the group.
APP_TIMEZONE=Asia/Kathmandu

# Canonical application origin, for example http://localhost:3000 locally.
NEXT_PUBLIC_APP_URL=
